// https://leetcode.cn/problems/power-of-two/solutions/yan-ge-zheng-ming-yi-xing-xie-fa-pythonj-h04o/
// 小节：（无小节标题）
// 说明：外部题解，非本人实现；抓取于 2026-10-27

class Solution {
public:
    bool isPowerOfTwo(int n) {
        return n > 0 && (n & (n - 1)) == 0;
    }
};
