{
  "title": "团购账单",
  "solution": "../../综合题/数字与运算/12_综合_团购账单.py",
  "comparison": "tokens",
  "timeout_seconds": 2,
  "cases": [
    {"name": "01 样例", "input": "12.5 3 20 5 50\n", "expected": "37.50\n35.00\n15.00\n"},
    {"name": "02 不减免", "input": "10 2 0 3 30\n", "expected": "20.00\n23.00\n7.00\n"},
    {"name": "03 商品金额全免但运费保留", "input": "10 2 100 3 10\n", "expected": "20.00\n3.00\n7.00\n"},
    {"name": "04 数量为零仍有运费", "input": "12.5 0 20 5 10\n", "expected": "0.00\n5.00\n5.00\n"},
    {"name": "05 单价为零", "input": "0 10 50 2 5\n", "expected": "0.00\n2.00\n3.00\n"},
    {"name": "06 无运费", "input": "8 5 25 0 50\n", "expected": "40.00\n30.00\n20.00\n"},
    {"name": "07 恰好付款", "input": "20 3 10 6 60\n", "expected": "60.00\n60.00\n0.00\n"},
    {"name": "08 多步小数计算", "input": "0.99 7 15 1.25 10\n", "expected": "6.93\n7.14\n2.86\n"},
    {"name": "09 极小商品金额", "input": "0.01 1 20 0 1\n", "expected": "0.01\n0.01\n0.99\n"},
    {"name": "10 最大商品总价", "input": "1000 1000 30 50 1000000\n", "expected": "1000000.00\n700050.00\n299950.00\n"},
    {"name": "11 单件与小数运费", "input": "7.5 1 40 2.5 20\n", "expected": "7.50\n7.00\n13.00\n"},
    {"name": "12 连续空格与首尾空白", "input": "  12.5   3  20    5  50  \n", "expected": "37.50\n35.00\n15.00\n"},
    {"name": "13 制表符分隔", "input": "8\t5\t25\t0\t50\n", "expected": "40.00\n30.00\n20.00\n"},
    {"name": "14 小减免比例", "input": "9.99 10 1 0.1 100\n", "expected": "99.90\n99.00\n1.00\n"},
    {"name": "15 大减免比例", "input": "9.99 10 99 0.1 100\n", "expected": "99.90\n1.10\n98.90\n"},
    {"name": "16 全零金额", "input": "0 0 0 0 0\n", "expected": "0.00\n0.00\n0.00\n"},
    {"name": "17 运费上限", "input": "1 1 100 1000 1000\n", "expected": "1.00\n1000.00\n0.00\n"},
    {"name": "18 较大数量与百分比", "input": "1.01 999 33 0.05 2000\n", "expected": "1008.99\n676.07\n1323.93\n"},
    {"name": "19 二分之一减免", "input": "0.25 8 50 0.2 5\n", "expected": "2.00\n1.20\n3.80\n"},
    {"name": "20 只有一次运费", "input": "2 10 50 3 30\n", "expected": "20.00\n13.00\n17.00\n"}
  ]
}
