{
  "title": "进制转换与精确复利",
  "solution": "../../基础题/数字与运算/16_进制转换与精确复利.py",
  "comparison": "exact",
  "timeout_seconds": 2,
  "cases": [
    {
      "name": "01 样例",
      "input": "10 0.001 0.2\n",
      "expected": "0b1010 0o12 0xa\n1.44 0.69\n0.3\n"
    },
    {
      "name": "02 零值边界",
      "input": "0 0 0.0\n",
      "expected": "0b0 0o0 0x0\n1.00 1.00\n0.1\n"
    },
    {
      "name": "03 经典进制数425",
      "input": "425 0.01 0.25\n",
      "expected": "0b110101001 0o651 0x1a9\n37.78 0.03\n0.35\n"
    },
    {
      "name": "04 2的幂次边界",
      "input": "256 0.005 1.1\n",
      "expected": "0b100000000 0o400 0x100\n6.17 0.16\n1.2\n"
    },
    {
      "name": "05 最大整数与百分之一",
      "input": "100000 0.01 2.2\n",
      "expected": "0b11000011010100000 0o303240 0x186a0\n37.78 0.03\n2.3\n"
    },
    {
      "name": "06 较大变化率0.03",
      "input": "15 0.03 0.9\n",
      "expected": "0b1111 0o17 0xf\n48482.72 0.00\n1.0\n"
    },
    {
      "name": "07 极小变化率0.0001",
      "input": "7 0.0001 0.05\n",
      "expected": "0b111 0o7 0x7\n1.04 0.96\n0.15\n"
    },
    {
      "name": "08 十六进制字母边界",
      "input": "255 0.002 0.33\n",
      "expected": "0b11111111 0o377 0xff\n2.07 0.48\n0.43\n"
    },
    {
      "name": "09 三位小数累加",
      "input": "1 0.003 0.875\n",
      "expected": "0b1 0o1 0x1\n2.98 0.33\n0.975\n"
    },
    {
      "name": "10 多余空格输入",
      "input": "  1023   0.02   99.9  \n",
      "expected": "0b1111111111 0o1777 0x3ff\n1377.41 0.00\n100.0\n"
    }
  ]
}
