{
  "title": "包裹分箱与时间推算",
  "solution": "../../挑战题/数字与运算/17_挑战_包裹分箱与时间推算.py",
  "comparison": "exact",
  "timeout_seconds": 2,
  "cases": [
    {
      "name": "01 样例跨天补零",
      "input": "23 5 150 1380 125\n",
      "expected": "4 3 5\n7.50\n+1d 01:05\n"
    },
    {
      "name": "02 零件货物",
      "input": "0 10 500 90 0\n",
      "expected": "0 0 0\n0.00\n+0d 01:30\n"
    },
    {
      "name": "03 恰好整箱与零点",
      "input": "40 8 250 0 1440\n",
      "expected": "5 0 5\n12.50\n+1d 00:00\n"
    },
    {
      "name": "04 不足一箱且箱容为1",
      "input": "7 1 99 1439 1\n",
      "expected": "7 0 7\n6.93\n+1d 00:00\n"
    },
    {
      "name": "05 不足一箱非1",
      "input": "3 10 105 600 45\n",
      "expected": "0 3 1\n1.05\n+0d 10:45\n"
    },
    {
      "name": "06 刚好差1件多一箱",
      "input": "11 10 1 500 99\n",
      "expected": "1 1 2\n0.02\n+0d 09:59\n"
    },
    {
      "name": "07 刚好满两箱与23:59",
      "input": "20 10 333 1200 239\n",
      "expected": "2 0 2\n6.66\n+0d 23:59\n"
    },
    {
      "name": "08 跨越多天",
      "input": "100 12 75 1430 10000\n",
      "expected": "8 4 9\n6.75\n+7d 22:30\n"
    },
    {
      "name": "09 较大件数与单箱费用",
      "input": "1000000 3 10000 725 100000\n",
      "expected": "333333 1 333334\n33333400.00\n+69d 22:45\n"
    },
    {
      "name": "10 零点出发零耗时",
      "input": "1 1000 1 0 0\n",
      "expected": "0 1 1\n0.01\n+0d 00:00\n"
    },
    {
      "name": "11 单日最晚23:59",
      "input": "999 1000 50 1400 39\n",
      "expected": "0 999 1\n0.50\n+0d 23:59\n"
    },
    {
      "name": "12 多余空格与制表符",
      "input": "  50\t7  200\t30   1410  \n",
      "expected": "7 1 8\n16.00\n+1d 00:00\n"
    }
  ]
}
