{
  "title": "单位切片与格式对齐",
  "solution": "../../基础题/字符串处理/25_补充_单位切片与格式对齐.py",
  "comparison": "exact",
  "timeout_seconds": 2,
  "cases": [
    {
      "name": "01 样例RMB转Euro与负数开方",
      "input": "123RMB\n-4 * 12\n",
      "expected": "15.58Euro\n++++++++++++++++++0.000+2.000j\n****-64*****\n"
    },
    {
      "name": "02 EUR转CNY与大数超宽不截断",
      "input": "999EUR\n1000 - 10\n",
      "expected": "7886.31CNY\n++++++++++++++++++++++++31.623\n1000000000\n"
    },
    {
      "name": "03 4字母Euro转RMB与0值",
      "input": "10Euro\n0 = 8\n",
      "expected": "78.94RMB\n+++++++++++++++++++++++++0.000\n===0====\n"
    },
    {
      "name": "04 CNY转EUR与小数金额",
      "input": "78.942CNY\n2 = 15\n",
      "expected": "10.00EUR\n+++++++++++++++++++++++++1.414\n=======8=======\n"
    },
    {
      "name": "05 0元合法边界与负数居中",
      "input": "0RMB\n-5 # 15\n",
      "expected": "0.00Euro\n++++++++++++++++++0.000+2.236j\n#####-125######\n"
    },
    {
      "name": "06 大小写不匹配报format error",
      "input": "100usd\n9 @ 10\n",
      "expected": "format error\n+++++++++++++++++++++++++3.000\n@@@729@@@@\n"
    },
    {
      "name": "07 Euro小写错写成euro",
      "input": "50euro\n16 + 10\n",
      "expected": "format error\n+++++++++++++++++++++++++4.000\n+++4096+++\n"
    },
    {
      "name": "08 缺少数值仅单位",
      "input": "RMB\n1 * 6\n",
      "expected": "format error\n+++++++++++++++++++++++++1.000\n**1***\n"
    },
    {
      "name": "09 负金额非法",
      "input": "-20CNY\n-9 - 20\n",
      "expected": "format error\n++++++++++++++++++0.000+3.000j\n---------729--------\n"
    },
    {
      "name": "10 数值部分含非数字字符",
      "input": "12aRMB\n25 . 10\n",
      "expected": "format error\n+++++++++++++++++++++++++5.000\n..15625...\n"
    }
  ]
}
