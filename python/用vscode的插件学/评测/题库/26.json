{
  "title": "数学函数与方程判别",
  "solution": "../../基础题/数字与运算/26_补充_数学函数与方程判别.py",
  "comparison": "exact",
  "timeout_seconds": 2,
  "cases": [
    {
      "name": "01 样例负整数与两实根",
      "input": "-5\n60,10,3\n1,-5,6\n",
      "expected": "5 -15 -5 -50\n1.3660 3 1 0 4\n2 2.00 3.00\n"
    },
    {
      "name": "02 正整数与零度角重根",
      "input": "100\n0,10,5\n1,-4,4\n",
      "expected": "100 110 90 1000\n1.0000 2 0 0 2\n1 2.00\n"
    },
    {
      "name": "03 零按正号算与无实根",
      "input": "0\n90,7,3\n1,1,1\n",
      "expected": "0 10 10 0\n1.0000 2 1 343 3\n0 NONE\n"
    },
    {
      "name": "04 负绝对值小于10陷阱与重根为0",
      "input": "-3\n180,2,10\n2,0,0\n",
      "expected": "3 -13 -7 -30\n-1.0000 0 2 24 1\n1 0.00\n"
    },
    {
      "name": "05 负绝对值等于10与45度角",
      "input": "-10\n45,17,4\n1,0,-9\n",
      "expected": "10 -20 0 -100\n1.4142 4 1 521 5\n2 -3.00 3.00\n"
    },
    {
      "name": "06 负a开口向下检验排序",
      "input": "-25\n30,5,5\n-1,1,6\n",
      "expected": "25 -35 -15 -250\n1.3660 1 0 125 1\n2 -2.00 3.00\n"
    },
    {
      "name": "07 负数整除零余幂与小重根",
      "input": "7\n270,3,200\n4,4,1\n",
      "expected": "7 17 3 70\n-1.0000 0 3 1 1\n1 -0.50\n"
    },
    {
      "name": "08 较大指数幂余pow高效求模",
      "input": "-1\n360,123,7\n2,-5,2\n",
      "expected": "1 -11 -9 -10\n1.0000 17 4 747 18\n2 0.50 2.00\n"
    },
    {
      "name": "09 整除无余数ceil不变与无根",
      "input": "10\n120,24,6\n5,2,1\n",
      "expected": "10 20 0 100\n0.3660 4 0 976 4\n0 NONE\n"
    },
    {
      "name": "10 极值边界1000与浮点系数",
      "input": "-1000\n30,999,10\n0.5,-1.5,1\n",
      "expected": "1000 -1010 -990 -10000\n1.3660 99 9 1 100\n2 1.00 2.00\n"
    }
  ]
}
