{
  "title": "列表遍历排序与别名",
  "solution": "../../基础题/列表与循环/31_列表遍历排序与别名.py",
  "comparison": "exact",
  "timeout_seconds": 2,
  "cases": [
    {
      "name": "01 样例多关键字与copy保护",
      "input": "-3 5 3 -1 0 5 -2\nAlice Bob Carol\n88 95 88\n",
      "expected": "1 0 0 0\n0 -1 -2 3 -3 5 5\n-3 97 | -3 5 3 -1 0 5 -2\n1:Bob(95) 2:Alice(88) 3:Carol(88)\n"
    },
    {
      "name": "02 无非负偶数输出NONE",
      "input": "-4 -2 -1 1 3 5\nTom Jerry\n70 70\n",
      "expected": "0 0 NONE NONE\n1 -1 -2 3 -4 5\n-4 96 | -4 -2 -1 1 3 5\n1:Jerry(70) 2:Tom(70)\n"
    },
    {
      "name": "03 单元素列表",
      "input": "0\nOnly\n100\n",
      "expected": "1 0 0 0\n0\n0 100 | 0\n1:Only(100)\n"
    },
    {
      "name": "04 全部非负偶数且重复",
      "input": "4 2 0 4 6 2\nZoe Amy Ben\n60 90 90\n",
      "expected": "6 18 0 6\n0 2 2 4 4 6\n4 104 | 4 2 0 4 6 2\n1:Amy(90) 2:Ben(90) 3:Zoe(60)\n"
    },
    {
      "name": "05 相同绝对值正负成对",
      "input": "-5 5 -10 10 0 -1 1\nLi Wang Zhao Sun\n80 95 80 100\n",
      "expected": "2 10 0 10\n0 1 -1 5 -5 10 -10\n-5 95 | -5 5 -10 10 0 -1 1\n1:Sun(100) 2:Wang(95) 3:Li(80) 4:Zhao(80)\n"
    },
    {
      "name": "06 全负数与零",
      "input": "-9 -8 -7 0 -8\nA B\n50 60\n",
      "expected": "1 0 0 0\n0 -7 -8 -8 -9\n-9 91 | -9 -8 -7 0 -8\n1:B(60) 2:A(50)\n"
    },
    {
      "name": "07 原序恰好有序检验copy未改原表",
      "input": "1 2 3 4 5\nD C B A\n10 20 30 40\n",
      "expected": "2 6 2 4\n1 2 3 4 5\n1 101 | 1 2 3 4 5\n1:A(40) 2:B(30) 3:C(20) 4:D(10)\n"
    },
    {
      "name": "08 首元素为极大负数",
      "input": "-100 50 -50 2 8\nAnn Bob Ada\n85 85 85\n",
      "expected": "3 60 2 50\n2 8 50 -50 -100\n-100 0 | -100 50 -50 2 8\n1:Ada(85) 2:Ann(85) 3:Bob(85)\n"
    },
    {
      "name": "09 全同元素列表",
      "input": "7 7 7 7\nOne Two\n0 0\n",
      "expected": "0 0 NONE NONE\n7 7 7 7\n7 107 | 7 7 7 7\n1:One(0) 2:Two(0)\n"
    },
    {
      "name": "10 较多元素与混合正负",
      "input": "12 -12 0 6 -6 15 -3 3 8\nEva Dan Mia Leo\n92 85 92 99\n",
      "expected": "4 26 0 12\n0 3 -3 6 -6 8 12 -12 15\n12 112 | 12 -12 0 6 -6 15 -3 3 8\n1:Leo(99) 2:Eva(92) 3:Mia(92) 4:Dan(85)\n"
    }
  ]
}
