{
  "title": "format迷你语言全解",
  "solution": "../../基础题/字符串处理/36_format迷你语言全解.py",
  "comparison": "exact",
  "timeout_seconds": 2,
  "cases": [
    {
      "name": "01 样例42多进制千分位截断与补零",
      "input": "42 65\n12345.6789 0.125\ncaterpillar * 8 3\n",
      "expected": "101010 | 52 | 42 | 2a | 2A | A\n12,345.68 1.23e+04 12.5%\n[**cat***]\n[+0000042|cat       ]\n"
    },
    {
      "name": "02 零值n=0与ratio=0与小写a(97)",
      "input": "0 97\n0.0 0.0\npython = 10 4\n",
      "expected": "0 | 0 | 0 | 0 | 0 | a\n0.00 0.00e+00 0.0%\n[===pyth===]\n[+0000000|pyth      ]\n"
    },
    {
      "name": "03 负数金额与最大ratio=1.0",
      "input": "255 90\n-9876543.21 1.0\nabcdefghij - 12 5\n",
      "expected": "11111111 | 377 | 255 | ff | FF | Z\n-9,876,543.21 -9.88e+06 100.0%\n[---abcde----]\n[+0000255|abcde     ]\n"
    },
    {
      "name": "04 word长度小于limit与宽度不足截断不裁",
      "input": "1024 122\n3.14159 0.056\nhi + 6 5\n",
      "expected": "10000000000 | 2000 | 1024 | 400 | 400 | z\n3.14 3.14e+00 5.6%\n[++hi++]\n[+0001024|hi        ]\n"
    },
    {
      "name": "05 width小于limit按截断后长度不截宽",
      "input": "15 77\n1000.0 0.999\nprogramming . 4 6\n",
      "expected": "1111 | 17 | 15 | f | F | M\n1,000.00 1.00e+03 99.9%\n[progra]\n[+0000015|progra    ]\n"
    },
    {
      "name": "06 极大n=100000与8位补零恰好满宽",
      "input": "100000 66\n99.9 0.5\nalgorithm # 15 4\n",
      "expected": "11000011010100000 | 303240 | 100000 | 186a0 | 186A0 | B\n99.90 9.99e+01 50.0%\n[#####algo######]\n[+0100000|algo      ]\n"
    },
    {
      "name": "07 奇数填充差额左少右多居中",
      "input": "7 100\n-0.005 0.3333\ndata _ 7 2\n",
      "expected": "111 | 7 | 7 | 7 | 7 | d\n-0.01 -5.00e-03 33.3%\n[__da___]\n[+0000007|da        ]\n"
    },
    {
      "name": "08 limit=1单字符截断与大宽度30",
      "input": "16 120\n1234567.5 0.75\nBIT ~ 30 1\n",
      "expected": "10000 | 20 | 16 | 10 | 10 | x\n1,234,567.50 1.23e+06 75.0%\n[~~~~~~~~~~~~~~B~~~~~~~~~~~~~~~]\n[+0000016|B         ]\n"
    },
    {
      "name": "09 最小宽度4且word恰好等于width",
      "input": "511 72\n42.0 0.001\ncode * 4 4\n",
      "expected": "111111111 | 777 | 511 | 1ff | 1FF | H\n42.00 4.20e+01 0.1%\n[code]\n[+0000511|code      ]\n"
    },
    {
      "name": "10 十六进制大小写x/X与最大code_pt=122",
      "input": "48879 122\n8888.885 0.618\nsequence = 14 6\n",
      "expected": "1011111011101111 | 137357 | 48879 | beef | BEEF | z\n8,888.89 8.89e+03 61.8%\n[====sequen====]\n[+0048879|sequen    ]\n"
    }
  ]
}
